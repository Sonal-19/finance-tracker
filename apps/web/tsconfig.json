{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["vite/client", "bun"],
    "paths": {
      "@/*": ["./src/*"],
      "@api": ["../api/src/index.ts"],
      "@api/*": ["../api/src/*"],
      "$": ["../api/src/index.ts"],
      "$/*": ["../api/src/*"]
    }
  },
  "include": ["src", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
