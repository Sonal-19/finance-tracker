{
  "name": "@finance/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "NODE_ENV=production bun build --minify-whitespace --minify-syntax --target bun --outfile server.js ./src/index.ts",
    "typecheck": "tsc --project ./tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push --force",
    "db:seed": "bun src/db/seed/index.ts",
    "db:make-admin": "bun src/db/scripts/make-admin.ts",
    "db:create-admin": "bun src/db/scripts/create-admin.ts",
    "db:move-user-config": "bun src/db/scripts/move-user-config.ts",
    "db:studio": "drizzle-kit studio --port 5577"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@passwordless-id/webauthn": "^2.4.0",
    "drizzle-orm": "catalog:",
    "elysia": "catalog:",
    "nodemailer": "^10.0.1",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/bun": "^1.4.1",
    "@types/nodemailer": "^8.0.1",
    "@types/web-push": "3.6.4",
    "drizzle-kit": "catalog:",
    "pg": "latest",
    "typescript": "catalog:"
  }
}
