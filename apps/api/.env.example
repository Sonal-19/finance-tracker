DATABASE_URL=postgres://sonal@localhost:5432/finance_tracker
PORT=4300
SESSION_DAYS=30
# SMTP for OTP emails (leave SMTP_HOST empty in dev: OTP is logged and 123456 is accepted)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Finance Tracker <no-reply@example.com>"
FX_FALLBACK_USD_INR=95
# Passkeys (WebAuthn). Defaults: localhost in dev, ft.u4.lol in production.
# RP_ID=ft.u4.lol
# RP_ORIGINS=https://ft.u4.lol
# Object storage for attachments: Cloudflare R2 or any S3 (private bucket; files
# are served through short-lived signed URLs). Leave empty in dev to store
# files on local disk under LOCAL_STORAGE_DIR instead.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_BUCKET=
# S3_REGION=auto
# LOCAL_STORAGE_DIR=./storage
